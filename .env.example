APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Admin Console host (Next.js) — legacy /he-thong/* redirects here; also used for CORS
ADMIN_APP_URL=https://admin.vitravel.dev

# CORS — origins của Admin Console (comma-separated). ADMIN_APP_URL luôn được thêm tự động.
# CORS_ALLOWED_ORIGINS=https://admin.vitravel.dev,https://admin.vitravel.net,http://localhost:3100

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=en_US
APP_DEFAULT_LOCALE=vi
APP_CURRENCY_DEFAULT=VND
APP_CACHE_HTML=false

# ── Multi-project runtime (config/project.php) ──
# Seed: php artisan migrate:fresh --seed  (seeds ALL project/seed_*.php)
# One profile: php artisan project:seed hicatba --domain=hicatba.dev --domain=hicatba.com
# Optional public fallback when Host không khớp project_domains:
# PROJECT_DEFAULT_CODE=vitravel
# Allow ?project= / cookie vt_project on same Host (default = APP_DEBUG):
# PROJECT_PUBLIC_QUERY_OVERRIDE=true
# PROJECT_REQUIRE_ADMIN_HEADER=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Media + Google Cloud Storage (chuẩn đa dự án — docs/gcs-standard.md) ──
MEDIA_DISK=public
MEDIA_UPLOAD_FOLDER=vitravel/images
MEDIA_HOME_SLIDER_FOLDER=vitravel/home-slider
MEDIA_HOME_SECTIONS_FOLDER=vitravel/home-sections
MEDIA_MAX_UPLOAD_KB=5120
MEDIA_MAX_VIDEO_UPLOAD_KB=1048576

# Khi MEDIA_DISK=gcs — bắt buộc 4 biến sau (+ file JSON trên disk)
# GCS_PROJECT_ID=
# GCS_BUCKET=
# GCS_KEY_FILE=storage/app/gcs-credentials.json
# GCS_PUBLIC_URL=https://storage.googleapis.com/your-bucket
# GCS_PATH_PREFIX=

# ── AI providers (OpenAI / Gemini / DeepSeek — OpenAI-compatible) ──
# Copy keys từ baseos.dev khi cần. Provider nào có key dùng được ngay.
AI_DEFAULT_PROVIDER=openai
AI_FALLBACK_PROVIDERS=openai,google,deepseek
# AI_TIMEOUT=180
# AI_MAX_TOKENS=8192
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-4o-mini
AI_OPENAI_TIMEOUT=180
GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=180
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=300

