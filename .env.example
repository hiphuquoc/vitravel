APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Next.js admin console (admin/) — CORS for browser calls if not using rewrite proxy
ADMIN_CORS_ORIGIN=http://localhost:3100

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=en_US
APP_DEFAULT_LOCALE=vi
APP_CURRENCY_DEFAULT=VND
APP_CACHE_HTML=false

# ── Project seed profile (config/project.php) ──
# vitravel → project/seed_vitravel.php | other → project/seed_other.php
PROJECT_SEED=vitravel
# PROJECT_SEED_DIR=project

# ── Company (config/company.php) — hotline, schema, footer, social ──
COMPANY_NAME=ViTravel
COMPANY_LEGAL_NAME="Công ty TNHH Du lịch ViTravel"
COMPANY_TAGLINE="Hài lòng hơn cả mong đợi"
COMPANY_SLOGAN="“Hài lòng hơn cả mong đợi”"
COMPANY_LICENSE=01-2234/TCDL-GP-LHQT
COMPANY_EMAIL=hello@vitravel.vn
COMPANY_PHONE="+84 24 3999 8888"
COMPANY_WHATSAPP="+84 912 345 678"
COMPANY_ZALO="+84 24 3999 8888"
COMPANY_ADDRESS_STREET="88 Xã Đàn, Đống Đa"
COMPANY_ADDRESS_LOCALITY="Hà Nội"
COMPANY_ADDRESS_REGION="Hà Nội"
COMPANY_ADDRESS_COUNTRY=VN
COMPANY_FACEBOOK=https://www.facebook.com/vitravel
COMPANY_YOUTUBE=https://www.youtube.com/@vitravel
COMPANY_INSTAGRAM=https://www.instagram.com/vitravel
COMPANY_TIKTOK=https://www.tiktok.com/@vitravel
# COMPANY_LOGO=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Media + Google Cloud Storage (chuẩn đa dự án — docs/gcs-standard.md) ──
MEDIA_DISK=public
MEDIA_UPLOAD_FOLDER=vitravel/images
MEDIA_HOME_SLIDER_FOLDER=vitravel/home-slider
MEDIA_HOME_SECTIONS_FOLDER=vitravel/home-sections
MEDIA_MAX_UPLOAD_KB=5120
MEDIA_MAX_VIDEO_UPLOAD_KB=1048576

# Khi MEDIA_DISK=gcs — bắt buộc 4 biến sau (+ file JSON trên disk)
# GCS_PROJECT_ID=
# GCS_BUCKET=
# GCS_KEY_FILE=storage/app/gcs-credentials.json
# GCS_PUBLIC_URL=https://storage.googleapis.com/your-bucket
# GCS_PATH_PREFIX=

# ── AI providers (OpenAI / Gemini / DeepSeek — OpenAI-compatible) ──
# Copy keys từ baseos.dev khi cần. Provider nào có key dùng được ngay.
AI_DEFAULT_PROVIDER=openai
AI_FALLBACK_PROVIDERS=openai,google,deepseek
# AI_TIMEOUT=180
# AI_MAX_TOKENS=8192
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-4o-mini
AI_OPENAI_TIMEOUT=180
GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=180
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=300

