# =============================================================================
# Nginx — site PUBLIC (Laravel multi-domain)
# Admin Console KHÔNG còn nằm dưới /he-thong — xem nginx-admin.conf.example
# =============================================================================

server {
    listen 80;
    listen 443 ssl http2;

    server_name vitravel.net www.vitravel.net
                hicatba.com www.hicatba.com
                phuquy.net www.phuquy.net;

    root /www/wwwroot/vitravel/public;
    index index.php index.html;

    charset utf-8;
    client_max_body_size 64M;

    # Legacy /he-thong → Laravel routes/admin.php redirect sang ADMIN_APP_URL
    # (không cần location riêng)

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/tmp/php-cgi-83.sock;
        fastcgi_index index.php;
        include fastcgi.conf;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_read_timeout 300;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    location ^~ /storage/ {
        try_files $uri =404;
        access_log off;
        expires 30d;
    }

    location ^~ /build/ {
        try_files $uri =404;
        access_log off;
        expires 7d;
        add_header Cache-Control "public";
    }

    location ~* /(\.env|composer\.(json|lock)|package(-lock)?\.json|artisan) {
        deny all;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
