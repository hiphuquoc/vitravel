############################################
# Production .env — multi-project ViTravel
# Copy → /www/wwwroot/vitravel/.env
# Rồi: php artisan key:generate && php artisan config:cache
############################################

APP_NAME=ViTravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://vitravel.net

# Admin Console (Next.js — host riêng)
ADMIN_APP_URL=https://admin.vitravel.net
CORS_ALLOWED_ORIGINS=https://admin.vitravel.net,https://admin.vitravel.dev

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_DEFAULT_LOCALE=vi
APP_CURRENCY_DEFAULT=VND

# HTML page cache (tắt khi debug UI)
APP_CACHE_HTML=true

# ── Multi-project ──
# Fallback khi Host không khớp project_domains
PROJECT_DEFAULT_CODE=vitravel
# Production: chỉ đổi dự án bằng domain thật (không ?project=)
PROJECT_PUBLIC_QUERY_OVERRIDE=false
# PROJECT_REQUIRE_ADMIN_HEADER=false

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vitravel
DB_USERNAME=vitravel
DB_PASSWORD=change_me_strong

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Để null khi nhiều domain khác nhau cùng app (cookie theo từng Host)
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis (nếu đổi QUEUE/CACHE sang redis)
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@vitravel.net"
MAIL_FROM_NAME="${APP_NAME}"

# ── Media ──
MEDIA_DISK=public
MEDIA_UPLOAD_FOLDER=vitravel/images
MEDIA_MAX_UPLOAD_KB=5120

# GCS (bỏ comment khi MEDIA_DISK=gcs) — docs/gcs-standard.md
# MEDIA_DISK=gcs
# GCS_PROJECT_ID=
# GCS_BUCKET=
# GCS_KEY_FILE=storage/app/gcs-credentials.json
# GCS_PUBLIC_URL=https://storage.googleapis.com/your-bucket
# GCS_PATH_PREFIX=

# Optional CORS nếu admin chạy origin khác (same-origin /he-thong thường không cần)
# CORS_ALLOWED_ORIGINS=

# AI (tuỳ chọn — admin translate)
# AI_DEFAULT_PROVIDER=openai
# AI_OPENAI_API_KEY=
