; Supervisor — Laravel queue worker (stay crawler + jobs khác)
; Copy tới /etc/supervisor/conf.d/vitravel-worker.conf
; hoặc dán vào aaPanel → Supervisor plugin
;
; sudo supervisorctl reread
; sudo supervisorctl update
; sudo supervisorctl start vitravel-worker:*
;
; --timeout=1200: đủ cho 1 URL chỗ nghỉ (gallery + phòng).
; numprocs=1: WithoutOverlapping stay-crawl-chrome — đừng tăng nếu máy yếu.

[program:vitravel-worker]
process_name=%(program_name)s_%(process_num)02d
command=php /www/wwwroot/vitravel.net/artisan queue:work database --sleep=3 --tries=3 --timeout=1200 --max-time=3600
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www
numprocs=1
redirect_stderr=true
stdout_logfile=/www/wwwroot/vitravel.net/storage/logs/worker.log
stopwaitsecs=1300
