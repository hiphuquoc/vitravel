{
  "name": "@vitravel/admin",
  "version": "0.1.0",
  "private": true,
  "description": "ViTravel Admin Console — headless Next.js admin for the multi-site travel platform",
  "scripts": {
    "dev": "node scripts/print-dev-url.cjs && next dev --port 3100 --hostname 0.0.0.0",
    "build": "bash scripts/build-prod.sh",
    "start": "next start --port 3100 --hostname 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sync": "node scripts/sync-to-public.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.525.0",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "sass": "^1.89.2",
    "typescript": "^5.8.3"
  }
}
